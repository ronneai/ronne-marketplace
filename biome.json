{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "extends": ["@ronneai/config/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/*.code-workspace",
      "!docs/UI-Mocks-Materials",
      "!**/__golden__",
      "!pnpm-lock.yaml"
    ]
  },
  "overrides": [
    {
      "includes": [
        "apps/web/src/**",
        "!apps/web/src/server/**",
        "!apps/web/src/app/api/**",
        "!apps/web/src/features/styleguide/**",
        "!apps/web/src/app/(app)/styleguide/**",
        "!**/*.test.tsx"
      ],
      "plugins": [
        "./packages/config/biome-plugins/i18n-raw-jsx-text.grit",
        "./packages/config/biome-plugins/i18n-raw-jsx-string.grit",
        "./packages/config/biome-plugins/i18n-raw-jsx-template.grit",
        "./packages/config/biome-plugins/i18n-raw-jsx-attribute.grit",
        "./packages/config/biome-plugins/i18n-raw-jsx-attribute-expression.grit"
      ]
    },
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronneai/web", "@ronneai/web/**"],
                    "message": "packages/core is shared by everything, so it can't import other Ronne packages (MVP §9.1)."
                  },
                  {
                    "group": ["@ronneai/rmk", "@ronneai/rmk/**"],
                    "message": "packages/core is shared by everything, so it can't import other Ronne packages (MVP §9.1)."
                  },
                  {
                    "group": ["@ronneai/mcp", "@ronneai/mcp/**"],
                    "message": "packages/core is shared by everything, so it can't import other Ronne packages (MVP §9.1)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cli/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronneai/web", "@ronneai/web/**"],
                    "message": "The CLI may only import @ronneai/core (MVP §9.1)."
                  },
                  {
                    "group": ["@ronneai/mcp", "@ronneai/mcp/**"],
                    "message": "The CLI may only import @ronneai/core (MVP §9.1)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/mcp/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronneai/web", "@ronneai/web/**"],
                    "message": "The MCP server may import @ronneai/core and @ronneai/rmk/lib, never the web app (MVP §9.1)."
                  },
                  {
                    "group": [
                      "@ronneai/rmk",
                      "@ronneai/rmk/**",
                      "!@ronneai/rmk/lib",
                      "!@ronneai/rmk/testing"
                    ],
                    "message": "The MCP server may import @ronneai/core and rmk's library entry, @ronneai/rmk/lib, never rmk's commands (MVP §9.1, feature 027)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronneai/rmk", "@ronneai/rmk/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["@ronneai/mcp", "@ronneai/mcp/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["better-sqlite3", "pg", "pg/**", "mysql2", "mysql2/**"],
                    "message": "Only apps/web/src/server/db may use a database driver. Use createDb() and the helpers in db/ instead (MVP §9.4, feature 002)."
                  },
                  {
                    "group": ["sonner", "sonner/**"],
                    "message": "Only components/ui/Toaster.tsx and toast.tsx import Sonner. Use useToast() instead, so it can be replaced (feature 138)."
                  },
                  {
                    "group": ["better-auth", "better-auth/**", "@better-auth/**"],
                    "message": "Only apps/web/src/server/domains/identity may use Better Auth. Use identity's actions instead (MVP §9.5, feature 006)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/server/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronneai/rmk", "@ronneai/rmk/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["@ronneai/mcp", "@ronneai/mcp/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["sonner", "sonner/**"],
                    "message": "Only components/ui/Toaster.tsx and toast.tsx import Sonner. Use useToast() instead, so it can be replaced (feature 138)."
                  },
                  {
                    "group": ["better-auth", "better-auth/**", "@better-auth/**"],
                    "message": "Only apps/web/src/server/domains/identity may use Better Auth. Use identity's actions instead (MVP §9.5, feature 006)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/server/domains/identity/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronneai/rmk", "@ronneai/rmk/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["@ronneai/mcp", "@ronneai/mcp/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["sonner", "sonner/**"],
                    "message": "Only components/ui/Toaster.tsx and toast.tsx import Sonner. Use useToast() instead, so it can be replaced (feature 138)."
                  },
                  {
                    "group": ["better-sqlite3", "pg", "pg/**", "mysql2", "mysql2/**"],
                    "message": "Only apps/web/src/server/db may use a database driver. Use createDb() and the helpers in db/ instead (MVP §9.4, feature 002)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/components/ui/Toaster.tsx",
        "apps/web/src/components/ui/toast.tsx",
        "apps/web/src/components/ui/toast.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronneai/rmk", "@ronneai/rmk/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["@ronneai/mcp", "@ronneai/mcp/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["better-sqlite3", "pg", "pg/**", "mysql2", "mysql2/**"],
                    "message": "Only apps/web/src/server/db may use a database driver. Use createDb() and the helpers in db/ instead (MVP §9.4, feature 002)."
                  },
                  {
                    "group": ["better-auth", "better-auth/**", "@better-auth/**"],
                    "message": "Only apps/web/src/server/domains/identity may use Better Auth. Use identity's actions instead (MVP §9.5, feature 006)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/e2e/**"],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    }
  ],
  "plugins": ["./packages/config/biome-plugins/no-function-declaration.grit"]
}
