{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "extends": ["@ronneai/config/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/*.code-workspace",
      "!docs/UI-Mocks-Materials",
      "!**/__golden__",
      "!pnpm-lock.yaml"
    ]
  },
  "overrides": [
    {
      "includes": [
        "apps/web/src/i18n/**",
        "apps/web/src/components/ui/**",
        "apps/web/src/components/app-shell/**",
        "apps/web/src/features/account/**",
        "apps/web/src/features/account-security/**",
        "apps/web/src/features/account-tokens/**",
        "apps/web/src/features/theme/**",
        "apps/web/src/features/sign-in/**",
        "apps/web/src/features/device/**",
        "apps/web/src/features/notice/**",
        "apps/web/src/components/catalogue/**",
        "apps/web/src/components/submissions/**",
        "apps/web/src/components/files/**",
        "apps/web/src/components/code/**",
        "apps/web/src/components/validation/**",
        "apps/web/src/components/risk-flags/**",
        "apps/web/src/components/tools/**",
        "apps/web/src/components/markdown/**",
        "apps/web/src/components/dependency-canvas/**",
        "apps/web/src/features/submissions/**",
        "apps/web/src/app/(app)/submissions/page.tsx",
        "apps/web/src/features/reviews/**",
        "apps/web/src/features/item-page/**",
        "apps/web/src/features/versions/**",
        "apps/web/src/features/releases/**",
        "apps/web/src/app/(app)/reviews/**",
        "apps/web/src/features/manifest-validation/**",
        "apps/web/src/app/(app)/submissions/new/**",
        "apps/web/src/features/draft-editor/**",
        "apps/web/src/app/(app)/submissions/\\[id\\]/**",
        "apps/web/src/components/help/Help.tsx",
        "apps/web/src/features/catalogue/**",
        "apps/web/src/app/(app)/catalogue/**",
        "apps/web/src/features/workspaces/**",
        "apps/web/src/features/workspace-members/**",
        "apps/web/src/features/workspace-requests/**",
        "apps/web/src/features/current-workspace/**",
        "apps/web/src/components/workspaces/**",
        "apps/web/src/app/(app)/workspaces/page.tsx",
        "apps/web/src/app/(app)/workspaces/\\[name\\]/page.tsx",
        "apps/web/src/app/(app)/workspaces/requests/**",
        "apps/web/src/app/(app)/workspaces/\\[name\\]/join/**",
        "apps/web/src/app/(app)/items/**",
        "apps/web/src/features/home/**",
        "apps/web/src/app/(app)/page.tsx",
        "apps/web/src/features/admin-settings/notice/**",
        "apps/web/src/features/favorites/**",
        "apps/web/src/features/pins/**",
        "apps/web/src/features/getting-started/**",
        "apps/web/src/features/feedback/**",
        "apps/web/src/features/admin-feedback/**",
        "apps/web/src/app/(app)/admin/feedback/**",
        "apps/web/src/features/admin-users/**",
        "apps/web/src/features/admin-scopes/**",
        "apps/web/src/features/admin-workspaces/**",
        "apps/web/src/app/(app)/admin/users/**",
        "apps/web/src/app/(app)/feedback/**",
        "apps/web/src/app/sign-in/**",
        "apps/web/src/app/(app)/device/**",
        "apps/web/src/app/(app)/account/**",
        "apps/web/src/app/(app)/layout.tsx",
        "apps/web/src/app/(app)/menu/**",
        "apps/web/src/app/not-found.tsx",
        "apps/web/src/app/error.tsx",
        "!**/*.test.tsx"
      ],
      "plugins": [
        "./packages/config/biome-plugins/i18n-raw-jsx-text.grit",
        "./packages/config/biome-plugins/i18n-raw-jsx-string.grit",
        "./packages/config/biome-plugins/i18n-raw-jsx-template.grit",
        "./packages/config/biome-plugins/i18n-raw-jsx-attribute.grit",
        "./packages/config/biome-plugins/i18n-raw-jsx-attribute-expression.grit"
      ]
    },
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronneai/web", "@ronneai/web/**"],
                    "message": "packages/core is shared by everything, so it can't import other Ronne packages (MVP §9.1)."
                  },
                  {
                    "group": ["@ronneai/rmk", "@ronneai/rmk/**"],
                    "message": "packages/core is shared by everything, so it can't import other Ronne packages (MVP §9.1)."
                  },
                  {
                    "group": ["@ronneai/mcp", "@ronneai/mcp/**"],
                    "message": "packages/core is shared by everything, so it can't import other Ronne packages (MVP §9.1)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cli/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronneai/web", "@ronneai/web/**"],
                    "message": "The CLI may only import @ronneai/core (MVP §9.1)."
                  },
                  {
                    "group": ["@ronneai/mcp", "@ronneai/mcp/**"],
                    "message": "The CLI may only import @ronneai/core (MVP §9.1)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/mcp/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronneai/web", "@ronneai/web/**"],
                    "message": "The MCP server may import @ronneai/core and @ronneai/rmk/lib, never the web app (MVP §9.1)."
                  },
                  {
                    "group": [
                      "@ronneai/rmk",
                      "@ronneai/rmk/**",
                      "!@ronneai/rmk/lib",
                      "!@ronneai/rmk/testing"
                    ],
                    "message": "The MCP server may import @ronneai/core and rmk's library entry, @ronneai/rmk/lib, never rmk's commands (MVP §9.1, feature 027)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronneai/rmk", "@ronneai/rmk/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["@ronneai/mcp", "@ronneai/mcp/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["better-sqlite3", "pg", "pg/**", "mysql2", "mysql2/**"],
                    "message": "Only apps/web/src/server/db may use a database driver. Use createDb() and the helpers in db/ instead (MVP §9.4, feature 002)."
                  },
                  {
                    "group": ["better-auth", "better-auth/**", "@better-auth/**"],
                    "message": "Only apps/web/src/server/domains/identity may use Better Auth. Use identity's actions instead (MVP §9.5, feature 006)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/server/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronneai/rmk", "@ronneai/rmk/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["@ronneai/mcp", "@ronneai/mcp/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["better-auth", "better-auth/**", "@better-auth/**"],
                    "message": "Only apps/web/src/server/domains/identity may use Better Auth. Use identity's actions instead (MVP §9.5, feature 006)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/server/domains/identity/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronneai/rmk", "@ronneai/rmk/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["@ronneai/mcp", "@ronneai/mcp/**"],
                    "message": "The web app may import @ronneai/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["better-sqlite3", "pg", "pg/**", "mysql2", "mysql2/**"],
                    "message": "Only apps/web/src/server/db may use a database driver. Use createDb() and the helpers in db/ instead (MVP §9.4, feature 002)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/e2e/**"],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    }
  ],
  "plugins": ["./packages/config/biome-plugins/no-function-declaration.grit"]
}
