{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["@ronne/config/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/*.code-workspace", "!docs/UI-Mocks-Materials"]
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronne/web", "@ronne/web/**"],
                    "message": "packages/core is shared by everything, so it can't import other Ronne packages (MVP §9.1)."
                  },
                  {
                    "group": ["@ronne/rmk", "@ronne/rmk/**"],
                    "message": "packages/core is shared by everything, so it can't import other Ronne packages (MVP §9.1)."
                  },
                  {
                    "group": ["@ronne/mcp", "@ronne/mcp/**"],
                    "message": "packages/core is shared by everything, so it can't import other Ronne packages (MVP §9.1)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cli/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronne/web", "@ronne/web/**"],
                    "message": "The CLI may only import @ronne/core (MVP §9.1)."
                  },
                  {
                    "group": ["@ronne/mcp", "@ronne/mcp/**"],
                    "message": "The CLI may only import @ronne/core (MVP §9.1)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/mcp/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronne/web", "@ronne/web/**"],
                    "message": "The MCP server may only import @ronne/core (MVP §9.1)."
                  },
                  {
                    "group": ["@ronne/rmk", "@ronne/rmk/**"],
                    "message": "The MCP server may only import @ronne/core (MVP §9.1)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronne/rmk", "@ronne/rmk/**"],
                    "message": "The web app may import @ronne/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["@ronne/mcp", "@ronne/mcp/**"],
                    "message": "The web app may import @ronne/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["better-sqlite3", "pg", "pg/**", "mysql2", "mysql2/**"],
                    "message": "Only apps/web/src/server/db may use a database driver. Use createDb() and the helpers in db/ instead (MVP §9.4, feature 002)."
                  },
                  {
                    "group": ["better-auth", "better-auth/**", "@better-auth/**"],
                    "message": "Only apps/web/src/server/domains/identity may use Better Auth. Use identity's actions instead (MVP §9.5, feature 006)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/server/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronne/rmk", "@ronne/rmk/**"],
                    "message": "The web app may import @ronne/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["@ronne/mcp", "@ronne/mcp/**"],
                    "message": "The web app may import @ronne/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["better-auth", "better-auth/**", "@better-auth/**"],
                    "message": "Only apps/web/src/server/domains/identity may use Better Auth. Use identity's actions instead (MVP §9.5, feature 006)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/server/domains/identity/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ronne/rmk", "@ronne/rmk/**"],
                    "message": "The web app may import @ronne/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["@ronne/mcp", "@ronne/mcp/**"],
                    "message": "The web app may import @ronne/core, never the CLI or the MCP server (MVP §9.1)."
                  },
                  {
                    "group": ["better-sqlite3", "pg", "pg/**", "mysql2", "mysql2/**"],
                    "message": "Only apps/web/src/server/db may use a database driver. Use createDb() and the helpers in db/ instead (MVP §9.4, feature 002)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
