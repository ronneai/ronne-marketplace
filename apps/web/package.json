{
  "name": "@ronneai/web",
  "version": "0.5.0",
  "private": true,
  "description": "Ronne marketplace web app: UI, server actions and the /api/v1 registry API.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsdown",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @ronneai/core --silent build && tsx scripts/migrate.ts",
    "setup": "pnpm --filter @ronneai/core --silent build && tsx scripts/setup.ts",
    "reset-root-password": "pnpm --filter @ronneai/core --silent build && tsx scripts/reset-root-password.ts",
    "reset-two-factor": "pnpm --filter @ronneai/core --silent build && tsx scripts/reset-two-factor.ts",
    "revoke-access": "pnpm --filter @ronneai/core --silent build && tsx scripts/revoke-access.ts",
    "rotate-secret": "pnpm --filter @ronneai/core --silent build && tsx scripts/rotate-secret.ts",
    "disable-sso": "pnpm --filter @ronneai/core --silent build && tsx scripts/disable-sso.ts",
    "backup": "pnpm --filter @ronneai/core --silent build && tsx scripts/backup.ts",
    "restore": "pnpm --filter @ronneai/core --silent build && tsx scripts/restore.ts",
    "purge": "pnpm --filter @ronneai/core --silent build && tsx scripts/purge.ts",
    "reset-setup": "tsx scripts/reset-setup.ts",
    "test:db": "pnpm --filter @ronneai/core --silent build && vitest run --project db",
    "bench:feeds": "pnpm --filter @ronneai/core --silent build && tsx scripts/feed-benchmark.ts",
    "bench:backup": "pnpm --filter @ronneai/core --silent build && tsx --expose-gc scripts/backup-benchmark.ts",
    "build:scripts": "tsdown",
    "test:e2e": "pnpm --filter @ronneai/core build && pnpm --filter @ronneai/rmk build && pnpm --filter @ronneai/mcp build && next build && playwright test"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@floating-ui/react": "0.27.20",
    "@lezer/highlight": "1.2.5",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@ronneai/core": "workspace:*",
    "@vercel/otel": "2.1.3",
    "@xyflow/react": "12.12.0",
    "better-auth": "1.7.12",
    "better-sqlite3": "13.0.3",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "kysely": "0.29.7",
    "lucide-react": "1.61.0",
    "marked": "18.1.1",
    "mysql2": "3.24.6",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "oauth4webapi": "3.8.8",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ulid": "3.0.2",
    "uqr": "0.1.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.2",
    "tsx": "4.23.15"
  }
}
