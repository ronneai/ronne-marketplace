{
  "name": "@ronneai/web",
  "version": "0.1.1",
  "private": true,
  "description": "Ronne marketplace web app: UI, server actions and the /api/v1 registry API.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsdown",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @ronneai/core --silent build && tsx scripts/migrate.ts",
    "setup": "pnpm --filter @ronneai/core --silent build && tsx scripts/setup.ts",
    "reset-root-password": "pnpm --filter @ronneai/core --silent build && tsx scripts/reset-root-password.ts",
    "reset-setup": "tsx scripts/reset-setup.ts",
    "test:db": "pnpm --filter @ronneai/core --silent build && vitest run --project db",
    "build:scripts": "tsdown",
    "test:e2e": "pnpm --filter @ronneai/core build && pnpm --filter @ronneai/rmk build && pnpm --filter @ronneai/mcp build && next build && playwright test"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@floating-ui/react": "0.27.20",
    "@lezer/highlight": "1.2.4",
    "@node-rs/argon2": "2.2.1",
    "@ronneai/core": "workspace:*",
    "@xyflow/react": "12.12.0",
    "better-auth": "1.7.6",
    "better-sqlite3": "13.0.3",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "kysely": "0.29.6",
    "lucide-react": "1.48.0",
    "marked": "18.0.14",
    "mysql2": "3.24.4",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ulid": "3.0.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.0",
    "tsx": "4.23.15"
  }
}
