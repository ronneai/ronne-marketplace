# Ronne configuration. The setup (in the browser, or `pnpm run setup`) writes .env for you; this
# file documents each key.
# .env is read by the web app and by `pnpm db:migrate`. Keep it private (setup creates it as 0600).

# Where the data lives. One of:
#   file:./data/ronne.db                                 SQLite (default), relative to apps/web
#   mysql://user:password@host:3306/database             MySQL 8.4+ or MariaDB 10.11+
#   postgres://user:password@host:5432/database          PostgreSQL 15+
# Special characters in the user or password must be URL-encoded (setup does this).
DATABASE_URL=file:./data/ronne.db

# Signs session cookies. 32 random bytes, base64. Changing it signs everyone out.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Where published item archives are stored (local disk).
STORAGE_PATH=./data/storage

# The address people use to open Ronne, without a trailing slash.
PUBLIC_URL=http://localhost:3000

# Set to true only when a reverse proxy you control sits in front of Ronne. Ronne then reads the
# client's address from X-Forwarded-For (for the sign-in rate limit and sessions). Default: false.
# TRUST_PROXY=false
