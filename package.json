{
  "name": "ronne-marketplace",
  "private": true,
  "description": "Self-hosted, curated registry of AI capabilities for AI coding tools.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ronneai/web",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "hooks:install": "git config core.hooksPath .githooks",
    "licenses:check": "pnpm licenses list --json | node packages/repo-tools/src/check-licenses.js",
    "db:migrate": "pnpm --filter @ronneai/web db:migrate",
    "setup": "pnpm --filter @ronneai/web run setup",
    "reset-root-password": "pnpm --filter @ronneai/web run reset-root-password",
    "reset-setup": "pnpm --filter @ronneai/web run reset-setup",
    "test:db": "pnpm --filter @ronneai/web test:db",
    "test:db:up": "docker compose -f docker/test-databases.compose.yml up -d --wait",
    "test:db:down": "docker compose -f docker/test-databases.compose.yml down -v",
    "test:db:postgres": "pnpm --filter @ronneai/web exec node scripts/test-db.mjs postgres",
    "test:db:mysql": "pnpm --filter @ronneai/web exec node scripts/test-db.mjs mysql",
    "test:db:mariadb": "pnpm --filter @ronneai/web exec node scripts/test-db.mjs mariadb",
    "test:e2e": "pnpm --filter @ronneai/web test:e2e",
    "packages:check": "node packages/repo-tools/src/check-packs.js",
    "release:version": "node packages/repo-tools/src/release-version.js",
    "release:smoke": "node packages/repo-tools/src/release-smoke.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@ronneai/config": "workspace:*",
    "@ronneai/rmk": "workspace:*",
    "@types/node": "22.20.4",
    "turbo": "2.11.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
