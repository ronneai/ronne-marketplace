{
  "name": "ronne-marketplace",
  "private": true,
  "description": "Self-hosted, curated registry of AI capabilities for AI coding tools.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node packages/repo-tools/src/trim-caches.js && turbo run dev --filter=@ronneai/web",
    "build": "node packages/repo-tools/src/trim-caches.js && turbo run build",
    "clean:cache": "node packages/repo-tools/src/trim-caches.js --all",
    "clean": "node packages/repo-tools/src/trim-caches.js --all && node -e \"for (const p of ['.turbo','apps/web/.next','apps/web/dist-scripts','packages/core/dist','packages/cli/dist','packages/mcp/dist','packages/server/dist','packages/server/app']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "hooks:install": "git config core.hooksPath .githooks",
    "witness:check": "node packages/repo-tools/src/check-witness.js",
    "licenses:check": "pnpm licenses list --json | node packages/repo-tools/src/check-licenses.js",
    "db:migrate": "pnpm --filter @ronneai/web db:migrate",
    "setup": "pnpm --filter @ronneai/web run setup",
    "reset-root-password": "pnpm --filter @ronneai/web run reset-root-password",
    "reset-setup": "pnpm --filter @ronneai/web run reset-setup",
    "test:db": "pnpm --filter @ronneai/web test:db",
    "test:db:up": "docker compose -f docker/test-databases.compose.yml up -d --wait",
    "test:db:down": "docker compose -f docker/test-databases.compose.yml down -v",
    "test:db:postgres": "pnpm --filter @ronneai/web exec node scripts/test-db.mjs postgres",
    "test:db:mysql": "pnpm --filter @ronneai/web exec node scripts/test-db.mjs mysql",
    "test:db:mariadb": "pnpm --filter @ronneai/web exec node scripts/test-db.mjs mariadb",
    "test:e2e": "pnpm --filter @ronneai/web test:e2e",
    "packages:check": "node packages/repo-tools/src/check-packs.js",
    "release:version": "node packages/repo-tools/src/release-version.js",
    "release:smoke": "node packages/repo-tools/src/release-smoke.js",
    "bundle": "node packages/repo-tools/src/bundle.js",
    "build:server": "NEXT_OUTPUT=standalone pnpm --filter \"@ronneai/web...\" build && pnpm --filter @ronneai/marketplace build",
    "test:install": "dash scripts/install/test-install.sh && bash scripts/install/test-install.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@ronneai/config": "workspace:*",
    "@ronneai/rmk": "workspace:*",
    "@types/node": "22.20.5",
    "turbo": "2.11.6",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
