{
  "name": "ronne-marketplace",
  "private": true,
  "description": "Self-hosted, curated registry of AI capabilities for AI coding tools.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ronne/web",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "hooks:install": "git config core.hooksPath .githooks",
    "licenses:check": "pnpm licenses list --json | node packages/repo-tools/src/check-licenses.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@ronne/config": "workspace:*",
    "@ronne/rmk": "workspace:*",
    "@types/node": "26.6.2",
    "turbo": "2.11.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
