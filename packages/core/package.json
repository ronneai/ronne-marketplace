{
  "name": "@ronneai/core",
  "version": "0.3.0",
  "description": "Manifest schema, resolver, packer and AI tool renderers shared by Ronne AI Marketplace, rmk and its MCP server.",
  "keywords": [
    "ronne",
    "ai",
    "agent-skills",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "manifest"
  ],
  "license": "MIT",
  "homepage": "https://www.ronne.ai/en/marketplace",
  "bugs": {
    "url": "https://github.com/ronneai/ronne-marketplace/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronneai/ronne-marketplace.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pack": {
      "types": "./dist/pack/index.d.ts",
      "default": "./dist/pack/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "default": "./dist/plugins/index.js"
    },
    "./read": {
      "types": "./dist/read/index.d.ts",
      "default": "./dist/read/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render/index.js"
    },
    "./schema.json": "./dist/schema/ronne.schema.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fflate": "^0.8.3",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/semver": "7.8.0",
    "smol-toml": "1.9.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
