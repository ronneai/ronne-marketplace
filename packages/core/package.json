{
  "name": "@ronneai/core",
  "version": "0.0.0",
  "description": "Manifest schema, resolver, packer and platform renderers shared by Ronne's web app, CLI and MCP server.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pack": {
      "types": "./dist/pack/index.d.ts",
      "default": "./dist/pack/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render/index.js"
    },
    "./schema.json": "./dist/schema/ronne.schema.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/semver": "7.8.0",
    "smol-toml": "1.9.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fflate": "0.8.3",
    "semver": "7.8.5",
    "yaml": "2.9.1"
  }
}
