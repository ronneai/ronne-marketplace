# Managed by rmk-server (feature 083). `sudo rmk-server service install` rewrites this file,
# and `sudo rmk-server service uninstall` removes it.
[Unit]
Description=Ronne AI Marketplace's HTTPS proxy (Caddy)
Documentation=https://github.com/ronneai/ronne-marketplace
After=network-online.target rmk-server.service
Wants=network-online.target

[Service]
Type=simple
User=caddy
Group=caddy
WorkingDirectory=/var/lib/rmk-server-proxy
Environment=HOME=/var/lib/rmk-server-proxy
Environment=XDG_DATA_HOME=/var/lib/rmk-server-proxy
Environment=XDG_CONFIG_HOME=/var/lib/rmk-server-proxy
ExecStart=/usr/bin/caddy run --config /etc/rmk-server-proxy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
TimeoutStopSec=30

# Hardening that leaves Node.js and Caddy working.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rmk-server-proxy
ProtectHome=true
PrivateTmp=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
