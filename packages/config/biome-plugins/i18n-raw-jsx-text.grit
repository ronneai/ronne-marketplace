language js

// Feature 129: text on the screen comes from the message files. The five i18n-raw-jsx-*.grit
// plugins run only on the folders listed in biome.json (the override that loads them), which grows
// as each area is translated. A string that is not translated text, such as a brand name or a
// protocol, carries `biome-ignore lint/plugin: <why>` (docs/knowledge/i18n.md).
// Text between tags, except inside <code>, <pre> and <kbd> (commands and file contents).
JsxText() as $s where {
  $s <: r"(?s).*\p{L}.*",
  $s <: not within `<code>$_</code>`,
  $s <: not within `<pre>$_</pre>`,
  $s <: not within `<kbd>$_</kbd>`,
  register_diagnostic(span=$s, message="Text on the screen comes from the message files (feature 129): use `t(...)`, not a string written here.", severity="error")
}
