{
  "name": "@ronneai/mcp",
  "version": "0.0.0",
  "description": "MCP server that lets AI coding tools search and install items from a Ronne marketplace.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@ronneai/core": "workspace:^",
    "@ronneai/rmk": "workspace:^",
    "zod": "^4.6.5"
  },
  "bin": {
    "rmk-mcp": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22.12"
  }
}
