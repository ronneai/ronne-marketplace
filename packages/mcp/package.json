{
  "name": "@ronneai/mcp",
  "version": "0.2.0",
  "description": "rmk-mcp: an MCP server that lets AI coding tools search and install items from a Ronne AI Marketplace.",
  "keywords": [
    "ronne",
    "mcp",
    "model-context-protocol",
    "ai",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor"
  ],
  "license": "MIT",
  "homepage": "https://www.ronne.ai/en/marketplace",
  "bugs": {
    "url": "https://github.com/ronneai/ronne-marketplace/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronneai/ronne-marketplace.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "bin": {
    "rmk-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@ronneai/core": "workspace:^",
    "@ronneai/rmk": "workspace:^",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
